+def v200_native_pages() -> Dict[str, List[Any]]:
+    lang = current_lang()
+    labels = PAGE_LABELS.get(lang, PAGE_LABELS.get("English", {}))
+    used_urls = set()
+
+    def make_page(key: str, icon: str = "•") -> Any:
+        title = labels.get(key, key.replace("_", " ").title())
+        base_url = key.replace("_", "-")
+        url = base_url
+        suffix = 2
+        while url in used_urls:
+            url = f"{base_url}-{suffix}"
+            suffix += 1
+        used_urls.add(url)
+        return st.Page(ROUTES[key], title=title, icon=icon, url_path=url)
