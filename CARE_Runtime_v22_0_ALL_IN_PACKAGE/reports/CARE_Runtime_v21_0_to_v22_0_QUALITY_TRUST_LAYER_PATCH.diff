+def v220_route_audit() -> Dict[str, Any]:
+    names = list(ROUTES.keys())
+    duplicates = {name: names.count(name) for name in set(names) if names.count(name) > 1}
+    missing = []
+    for name, fn in ROUTES.items():
+        if not callable(fn):
+            missing.append(name)
+    label_en_missing = [r for r in ROUTES if r not in PAGE_LABELS.get("English", {})]
+    label_da_missing = [r for r in ROUTES if r not in PAGE_LABELS.get("Dansk", {})]
+    hero_missing = [r for r in ROUTES if r not in HERO]
+    return {
+        "routes": len(ROUTES),
+        "duplicates": duplicates,
+        "missing_callable_routes": missing,
+        "missing_english_labels": label_en_missing,
+        "missing_danish_labels": label_da_missing,
+        "missing_hero": hero_missing,
+        "ok": not duplicates and not missing,
+    }
+
+def v220_quality_score() -> int:
+    audit = v220_route_audit()
+    score = 100
+    if audit["duplicates"]:
+        score -= 15
+    if audit["missing_callable_routes"]:
+        score -= 25
+    if audit["missing_danish_labels"]:
+        score -= min(20, len(audit["missing_danish_labels"]))
+    if audit["missing_hero"]:
+        score -= min(10, len(audit["missing_hero"]))
+    return max(0, min(100, score))
